{
  "name": "@radhaparty/extension",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "package": "vite build --outDir release --emptyOutDir && rm -f radhaparty-*.zip && cd release && zip -qr ../radhaparty-$npm_package_version.zip ."
  },
  "dependencies": {
    "@radhaparty/shared": "workspace:*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.0",
    "vite": "^8.3.1"
  }
}
